{"nodes": [{"id": "recommerce_terra_review", "label": "Terra Architecture and Implementation Review", "file_type": "document", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "Review date 2026-08-27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_terra_review_rcr_001", "label": "RCR-001 Establish the release baseline and contain legacy Repair", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named IMPLEMENT FIRST because it is discovery and verification, not a feature build, and prevents an unavailable vendor Repair provider or cache from becoming an accidental runtime dependency."}, {"id": "recommerce_terra_review_rcr_002", "label": "RCR-002 Profile the approved Alpha cohort, hardware, and stock paths", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_terra_review_rcr_003", "label": "RCR-003 Decide and prove the atomic tracked-receiving integration contract", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_terra_review_rcr_004", "label": "RCR-004 Scaffold an inactive Recommerce module and cohort switch", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_terra_review_rcr_005", "label": "RCR-005 Add Alpha authorization and serialization-policy guardrails", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_terra_review_rcr_006", "label": "RCR-006 Add the minimal Device identity schema", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Poor schema constraints cannot be repaired safely after physical labels exist, so only Alpha constraints are created but they are created correctly the first time."}, {"id": "recommerce_terra_review_rcr_007", "label": "RCR-007 Implement safe Device-code and QR issuance", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_terra_review_rcr_008", "label": "RCR-008 Build Device detail and exact keyboard/manual scan resolution", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_terra_review_rcr_009", "label": "RCR-009 Render and prove one Device QR/Code128 label", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A visually correct but unreadable or wrong label is operationally worse than no label, so real printer, scanner, and browser proof is required rather than generated-image inspection."}, {"id": "recommerce_terra_review_rcr_010", "label": "RCR-010 Implement the narrow idempotent tracked-receive transaction", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This is the financial and inventory integrity boundary: the POS quantity change and the Device rows must commit or roll back together."}, {"id": "recommerce_terra_review_rcr_011", "label": "RCR-011 Build the real tracked-receiving browser flow", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_terra_review_rcr_012", "label": "RCR-012 Implement scoped reconciliation and stop-the-line exception", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reconciliation is the evidence that Recommerce remains a subledger rather than a competing stock ledger, so mismatch is immutable evidence with no automatic balancing."}, {"id": "recommerce_terra_review_rcr_013", "label": "RCR-013 Rehearse disable, rollback, and ordinary-POS regression", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_terra_review_rcr_014", "label": "RCR-014 Add camera scan capability after the asset baseline is recovered", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_terra_review_rcr_015", "label": "RCR-015 Implement SaverBro-owned shared repair foundation", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_terra_review_modular_monolith", "label": "Modular monolith boundary (Modules/Recommerce)", "file_type": "rationale", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Laravel module preserves vendor upgradeability and keeps atomic POS/device changes in one database transaction; a microservice would make the first stock invariant harder, not safer."}, {"id": "recommerce_terra_review_authority_split", "label": "POS/Recommerce authority split", "file_type": "rationale", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ultimate POS stays authoritative for catalogue, aggregate quantity, transactions, tax, invoices, payments and FIFO/LIFO; Recommerce owns physical identity, custody, movement evidence and reconciliation, so there is never a second competing stock or accounting ledger."}, {"id": "recommerce_terra_review_purchase_receiving_seam", "label": "Purchase-receiving integration contract (missing seam)", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a71, \u00a77, \u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PurchaseCreatedOrModified fires inside the core purchase transaction but carries a transaction, not a prepared list of device identities, and no purchase-form module hook exists, so an after-the-fact listener alone cannot turn a received purchase into exact devices; Alpha must pick either a module-owned receiving service or a minimal generic pre-commit purchase callback."}, {"id": "recommerce_terra_review_reconciliation_invariant", "label": "Stock reconciliation invariant (core qty = tracked devices + legacy balance)", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a72, \u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This is the operating invariant for a serialized variation/location; no silent divergence is acceptable, so unprotected sale/transfer/adjustment paths must be blocked or guarded for tracked variations."}, {"id": "recommerce_terra_review_opaque_qr_token", "label": "Opaque QR token resolver", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QR must never contain a database ID, IMEI, owner, location, cost or repair details; store only a keyed hash, print an approved HTTPS URL, and make the public GET a safe login deep link that discloses nothing and mutates nothing."}, {"id": "recommerce_terra_review_canonical_device", "label": "Canonical Device registry (recommerce_devices)", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One durable row per physical device that may outlive several ownership cycles; it must not be a product, variation, purchase line, sell line or repair job, and a variation must never be created per unit."}, {"id": "recommerce_terra_review_identity_separation", "label": "Three-way identity separation (device code, QR token, manufacturer identifiers)", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a72, \u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_terra_review_device_code_from_pk", "label": "Device code derived from inserted primary key", "file_type": "rationale", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a76.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Using the inserted Device primary key plus a unique (business_id, device_code) constraint means gaps after rollback are acceptable and safer than a new generic allocator; this replaces RC-010's separate sequence service for Alpha."}, {"id": "recommerce_terra_review_legacy_repair_containment", "label": "Legacy vendor Repair containment", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The missing vendor source blocks only a legacy Repair cutover (migrating open jobs, files, routes, receipts), not the owned repair build; status and cache files are evidence of intended or stale configuration, not proof of a live installed Repair workflow."}, {"id": "recommerce_terra_review_core_code_boundaries", "label": "Core code boundaries (do not broadly modify)", "file_type": "rationale", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ProductUtil, TransactionUtil, SellPosController, PurchaseController, StockTransferController, StockAdjustmentController, core models and LabelsController stay unmodified; any core change needs a one-purpose contract, inline rationale, feature flag, ordinary-flow regression test and an upgrade note."}, {"id": "recommerce_terra_review_infrastructure_classification", "label": "Alpha infrastructure classification (must have / needed soon / defer)", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generic command bus, generic scan router, ULID/UUID abstraction, dead-letter UI and generic state engine are deferred because Alpha has one receive command and one Device resolver; extract only after two or more real flows share stable behavior."}, {"id": "recommerce_terra_review_first_vertical_slice", "label": "First working vertical slice (receive, label, scan, reconcile)", "file_type": "concept", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a714", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_terra_review_serial_field_not_a_registry", "label": "enable_sr_no is invoice annotation, not a unit registry", "file_type": "rationale", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "transaction_sell_lines.sell_line_note has no per-unit purchase identity, uniqueness, custody or stock binding, so the physical registry must not be built on it."}, {"id": "recommerce_architecture", "label": "RECOMMERCE_ARCHITECTURE.md", "file_type": "document", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "Source evidence reviewed", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model", "label": "RECOMMERCE_DATA_MODEL.md", "file_type": "document", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "Source evidence reviewed", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_qr_scan_architecture", "label": "RECOMMERCE_QR_SCAN_ARCHITECTURE.md", "file_type": "document", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "Source evidence reviewed", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_migration_plan", "label": "RECOMMERCE_MIGRATION_PLAN.md", "file_type": "document", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "Source evidence reviewed", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_roadmap", "label": "RECOMMERCE_ROADMAP.md", "file_type": "document", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "Source evidence reviewed", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_security_and_permissions", "label": "RECOMMERCE_SECURITY_AND_PERMISSIONS.md", "file_type": "document", "source_file": "RECOMMERCE_TERRA_REVIEW.md", "source_location": "Source evidence reviewed", "source_url": null, "