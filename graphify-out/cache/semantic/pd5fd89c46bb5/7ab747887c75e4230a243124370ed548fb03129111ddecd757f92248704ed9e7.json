{"nodes": [{"id": "rcr_002_provisional_profile", "label": "RCR-002 Provisional Local/Source Profile", "file_type": "document", "source_file": "RCR_002_PROVISIONAL_PROFILE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_002_provisional_profile_blocked_decision", "label": "RCR-002 Remains BLOCKED", "file_type": "rationale", "rationale": "No defensible Alpha cohort can be selected from the source package: the only identifiable business records are dummy-seeder intent, which does not prove tables exist in deployment, that records are current, or that a location is approved for a pilot.", "source_file": "RCR_002_PROVISIONAL_PROFILE.md", "source_location": "Section 1 / Section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_002_provisional_profile_stock_control_surface", "label": "Core Stock-Control Surface", "file_type": "concept", "rationale": "Purchases, opening stock import, sales returns, stock adjustments, stock transfers, purchase returns and ProductUtil quantity services are the static stock-affecting paths a later approved profile must reconcile; a future integration must use verified core quantity conventions rather than a parallel stock authority.", "source_file": "RCR_002_PROVISIONAL_PROFILE.md", "source_location": "Section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_002_provisional_profile_identifier_profile", "label": "Identifier and Duplicate Profile Not Calculable", "file_type": "concept", "rationale": "A later evidence pack must distinguish product SKU/barcode, serial number, IMEI or other manufacturer identifier, and any existing human reference; none of these can be inferred from dummy seed intent.", "source_file": "RCR_002_PROVISIONAL_PROFILE.md", "source_location": "Section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_002_provisional_