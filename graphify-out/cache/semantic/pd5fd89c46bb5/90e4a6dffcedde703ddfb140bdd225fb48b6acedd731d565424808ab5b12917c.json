{"nodes": [{"id": "docs_tradein_acquisition_command_v1_integration_v2", "label": "Website Trade-In Integration V2", "file_type": "document", "source_file": "docs/TRADEIN_ACQUISITION_COMMAND_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing in this contract authorizes staging or production deployment; the V2 shape exists to pull authority back from the website into SAVERPOS."}, {"id": "docs_tradein_acquisition_command_v1_retired_commit_endpoint", "label": "Retired POST /api/trade-in-acquisition/v1/commit", "file_type": "concept", "source_file": "docs/TRADEIN_ACQUISITION_COMMAND_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retired and unrouted because it returned too much authority to the website."}, {"id": "docs_tradein_acquisition_command_v1_intakes_endpoint", "label": "POST /api/trade-in/v2/intakes", "file_type": "concept", "source_file": "docs/TRADEIN_ACQUISITION_COMMAND_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creates only recommerce_trade_in_intakes; no Product, Variation, Device, purchase, stock movement, accounting entry or payment, so intake can never be a commerce command."}, {"id": "docs_tradein_acquisition_command_v1_projection_endpoint", "label": "GET /api/trade-in/v2/intakes/{websiteCase}/projection", "file_type": "concept", "source_file": "docs/TRADEIN_ACQUISITION_COMMAND_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An explicit allowlist that excludes pricing internals, margins, reserves, ceilings, evidence amounts, staff notes, credentials and unrelated PII."}, {"id": "docs_tradein_acquisition_command_v1_decisions_endpoint", "label": "POST /api/trade-in/v2/intakes/{websiteCase}/decisions", "file_type": "concept", "source_file": "docs/TRADEIN_ACQUISITION_COMMAND_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The amount is never accepted from the caller; SAVERPOS resolves the offer and valuation itself so the website cannot set price."}, {"id": "docs_tradein_acquisition_command_v1_recommerce_trade_in_intakes", "label": "recommerce_trade_in_intakes table", "file_type": "concept", "source_file": "docs/TRADEIN_ACQUISITION_COMMAND_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_tradein_acquisition_command_v1_idempotency", "label": "Intake Idempotency Key ((business_id, source_system, external_case_reference) + fingerprint)", "file_type": "concept", "source_file": "docs/TRADEIN_ACQUISITION_COMMAND_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Durable idempotency so a lost response never becomes a second acquisition attempt; reuse with any changed offer, decision or mapping is a conflict rather than a cached success."}, {"id": "docs_tradein_acquisition_command_v1_native_mapping", "label": "Native Mapping Equality Rule", "file_type": "rationale", "source_file": "docs/TRADEIN_ACQUISITION_COMMAND_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "location_id, product_id, variation_id and device_id must equal the native valuation relationships; SAVERPOS never substitutes corrected values, and rejection happens before native acceptance so purchase/Device/movement/accounting/payment deltas remain zero."}, {"id": "docs_tradein_acquisition_command_v1_native_mapping_rejected", "label": "NATIVE_MAPPING_REJECTED timeline event", "file_type": "concept", "source_file": "docs/TRADEIN_ACQUISITION_COMMAND_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redacted by design: records case, POS case, command ID, field, expected/received IDs, actor and timestamp, but no bearer token, secret, customer detail or filesystem path."}, {"id": "docs_tradein_acquisition_command_v1_tradeinservice_accept", "label": "TradeInService::accept()", "file_type": "code", "source_file": "docs/TRADEIN_ACQUISITION_COMMAND_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_tradein_acquisition_command_v1_outbox_contract", "label": "Customer Projection Outbox Contract", "file_type": "concept", "source_file": "docs/TRADEIN_ACQUISITION_COMMAND_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One redacted immutable event per authoritative transition with strictly increasing aggregate versions (v1 INTAKE_ACKNOWLEDGED to v5 SETTLEMENT_UPDATED); redelivery retries the existing row and never creates another transition."}, {"id": "docs_tradein_acquisition_command_v1_settlement_updated", "label": "SETTLEMENT_UPDATED / recordSettlementChange()", "file_type": "concept", "source_file": "docs/TRADEIN_ACQUISITION_COMMAND_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Emitted once by the native Transaction payment_status observer inside the transactional payment update; callers must not invoke recordSettlementChange() separately for the same saved Transaction, avoiding duplicate settlement events."}], "edges": [{"source": "docs_tradein_acquisition_command_v1_integration_v2", "target": "docs_tradein_acquisition_command_v1_retired_commit_endpoint", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/TRADEIN_ACQUISITION_COMMAND_V1.md", "source_location": null, "weight": 1.0}, {"source": "docs_tradein_acquisition_command_v1_integration_v2", "target": "docs_tradein_acquisition_c