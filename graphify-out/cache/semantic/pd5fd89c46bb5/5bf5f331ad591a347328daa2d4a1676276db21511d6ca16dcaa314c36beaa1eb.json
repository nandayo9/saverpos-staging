n", "repair_service_architecture_pos_billing_integration", "repair_service_architecture_qc_handover", "repair_service_architecture_warranty"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REPAIR_SERVICE_ARCHITECTURE.md"}]}