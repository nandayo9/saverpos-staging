{"nodes": [{"id": "repair_service_architecture", "label": "Repair Service Architecture", "file_type": "document", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "repair_service_architecture_shared_repair_domain", "label": "Shared repair-job domain in Modules/Recommerce", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One canonical device registry and one job engine: the job type selects policies and allowed paths rather than creating two incompatible repair systems, and the owned domain must not write vendor Repair tables or reuse vendor entities."}, {"id": "repair_service_architecture_bounded_contexts", "label": "Repair bounded contexts and systems of record", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "repair_service_architecture_job_model", "label": "Repair job model", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Customer devices may have no product_id or variation_id; free-text make/model plus normalized identifiers suffices, and the same row later gains business ownership and a catalog variation if SaverBro acquires it."}, {"id": "repair_service_architecture_state_machine", "label": "Repair job state machine", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transitions are commands with prerequisites, not editable status fields; closed jobs are immutable and repeat visits create linked new jobs."}, {"id": "repair_service_architecture_resolution_code", "label": "resolution_code outcome field", "file_type": "rationale", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cancellation, customer decline and an unrepairable finding are outcome reasons, not parallel workflow states; storing them as a nullable resolution_code and routing the job through READY/handover prevents a declined device from being stranded outside the collection workflow."}, {"id": "repair_service_architecture_internal_refurbishment", "label": "INTERNAL_REFURBISHMENT job type", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a71, \u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "repair_service_architecture_customer_repair", "label": "CUSTOMER_REPAIR job type", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a71, \u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A customer-owned device is never stock-participating, so it cannot be assigned a product/variation as inventory merely because it sits in the workshop."}, {"id": "repair_service_architecture_intake", "label": "Repair intake (shared, customer, internal)", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Device passcodes are not stored by default; if temporary secret storage is approved it must be encrypted, separately permissioned, expiring, reveal-audited and automatically destroyed."}, {"id": "repair_service_architecture_diagnostics_grading", "label": "Versioned diagnostics and grading", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Submitted diagnostic sessions are immutable snapshots and free text alone is insufficient for required checks; provisional intake grade, post-repair grade and sale grade are preserved separately rather than overwriting one field."}, {"id": "repair_service_architecture_quote_approval", "label": "Quote versions and approval evidence", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Once sent a version is immutable and changes create a new version; Alpha may record approval evidence from existing channels but must not claim cryptographic customer signing unless implemented and verified, and estimates are never posted to accounting."}, {"id": "repair_service_architecture_parts_integration", "label": "Parts integration with POS stock", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Part master and quantities stay in Ultimate POS: the customer path decrements only at final invoice while the internal path posts a standard stock adjustment, and qty_available is never written directly."}, {"id": "repair_service_architecture_pos_billing_integration", "label": "POS invoice, payment, and accounting integration", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommerce stores stable links and display snapshots, not a competing balance ledger, and must not fork payment or accounting calculations; any core subtype/hook change stays generic and module-safe."}, {"id": "repair_service_architecture_qc_handover", "label": "QC and handover", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional separation of duties prevents the lead technician self-approving; internal handover to stock additionally requires business ownership, sellable variation, location, label and successful reconciliation."}, {"id": "repair_service_architecture_warranty", "label": "Service-instance warranty coverage", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a712", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claims are new linked repair jobs and warranty decisions never rewrite the original job or invoice."}, {"id": "repair_service_architecture_cost_ledger", "label": "Append-only cost ledger", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each entry targets exactly one of device or job, which prevents double-counting a customer repair cost on both while retaining lifetime service history; corrections append reversals and revenue stays in POS."}, {"id": "repair_service_architecture_privacy_controls", "label": "Repair privacy and sensitive-data controls", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a714", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passcodes are excluded from events, labels, exports, notifications and search indexes; identifiers are masked except for operational roles and file downloads are authorized at request time."}, {"id": "repair_service_architecture_notifications", "label": "Outbox-triggered repair notifications", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a715", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Channel integrations are adapters outside the transaction so delivery failure never changes job state; Alpha can operate on recorded manual contact actions while channels remain undecided."}, {"id": "repair_service_architecture_permissions", "label": "Action-specific repair permissions", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a716", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Permissions intersect business, location, assignment, job type/state and segregation of duty; technicians do not automatically receive contacts, costs, approvals, exports or temporary secrets, and possession of a job QR never grants access."}, {"id": "repair_service_architecture_timeline", "label": "Permanent repair/device event timeline", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a717", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existing general activity logs may mirror summaries but cannot replace the permanent timeline, because they carry generic semantics and retention cleanup."}, {"id": "repair_service_architecture_future_channels", "label": "Future WhatsApp and customer portal integration", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a718", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Future channels consume minimal versioned outbox messages and call the same authenticated services rather than writing repair tables; WhatsApp additionally needs a decision on whether a reply is merely evidence or a legally sufficient approval. Neither belongs in Alpha."}, {"id": "repair_service_architecture_reporting", "label": "Repair operational reporting", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a719", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "repair_service_architecture_integration_tests", "label": "Required repair integration tests", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a720", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "repair_service_architecture_alpha_exclusions", "label": "Repair Alpha exclusions", "file_type": "concept", "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a721", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "repair_service_architecture_permissions", "target": "recommerce_security_and_permissions", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a716", "weight": 1.0}, {"source": "repair_service_architecture_shared_repair_domain", "target": "repair_service_architecture_internal_refurbishment", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a71", "weight": 1.0}, {"source": "repair_service_architecture_shared_repair_domain", "target": "repair_service_architecture_customer_repair", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a71", "weight": 1.0}, {"source": "repair_service_architecture_shared_repair_domain", "target": "repair_service_architecture_bounded_contexts", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REPAIR_SERVICE_ARCHITECTURE.md", "source_location": "\u00a72", "weight": 1.0}, {"source": "repair_service_architecture_state_machine", "target": "repair_service_a