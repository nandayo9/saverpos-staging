{"nodes": [{"id": "docs_marketplace_canonical_catalogue_catalogue", "label": "Canonical Marketplace Catalogue", "file_type": "document", "source_file": "docs/marketplace/CANONICAL_CATALOGUE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Additive by design: unifies historical Trade-In model/variant IDs with public marketplace identity while owning no inventory, prices, payments or accounting."}, {"id": "docs_marketplace_canonical_catalogue_canonicaldevicecatalogue", "label": "CanonicalDeviceCatalogue", "file_type": "code", "source_file": "docs/marketplace/CANONICAL_CATALOGUE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Model identity is category plus case/whitespace-normalized brand/model/generation; slugs are stable and specification hashes / native variation mappings cannot be reassigned silently."}, {"id": "docs_marketplace_canonical_catalogue_intelligenceservice_variant_importer", "label": "IntelligenceService VARIANT importer", "file_type": "code", "source_file": "docs/marketplace/CANONICAL_CATALOGUE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_marketplace_canonical_catalogue_catalogue_model_kind", "label": "CATALOGUE_MODEL import kind", "file_type": "concept", "source_file": "docs/marketplace/CANONICAL_CATALOGUE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Models start DRAFT and PUBLISHED requires at least 80 plain-text characters in each content section; publication is still not permission to index or activate feeds."}, {"id": "docs_marketplace_canonical_catalogue_dry_run_script", "label": "scripts/canonical-catalogue-dry-run.php", "file_type": "code", "source_file": "docs/marketplace/CANONICAL_CATALOGUE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always rolls back and exits 2 on ambiguity; any ambiguity invalidates the whole candidate set, and it refuses 5,000 evidence records rather than silently claiming complete coverage."}, {"id": "docs_marketplace_canonical_catalogue_migration_2026_09_08_000003", "label": "Migration 2026_09_08_000003_create_canonical_device_catalogue", "file_type": "concept", "source_file": "docs/marketplace/CANONICAL_CATALOGUE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applied only after a verified private staging DB backup; the staging bootstrap enforces the backup when either new evidence/catalogue table is missing."}, {"id": "docs_marketplace_canonical_catalogue_public_device_status_endpoint", "label": "GET /devices/{publicDeviceId}/status", "file_type": "concept", "source_file": "docs/marketplace/CANONICAL_CATALOGUE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exposes only public identity/model/state for eligible previously published devices; sold or reserved data never appears as available inventory."}, {"id": "docs_marketplace_canonical_catalogue_slug_301", "label": "Historical Model Slug 301 Canonicalization", "file_type": "concept", "source_file": "docs/marketplace/CANONICAL_CATALOGUE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existing historical slugs resolve to the current canonical model and the website issues a 301, so model/specification pages survive zero stock without breaking old URLs."}, {"id": "docs_marketplace_canonical_catalogue_rollback_policy", "label": "Catalogue Rollback Policy", "file_type": "rationale", "source_file": "docs/marketplace/CANONICAL_CATALOGUE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "ra