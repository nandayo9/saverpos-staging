{"nodes": [{"id": "recommerce_migration_plan_document", "label": "Migration and Cutover Plan", "file_type": "document", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_migration_plan_migration_posture", "label": "Additive, Flag-Reversible Migration Posture", "file_type": "rationale", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Historical POS transactions are never rewritten and unit identities are never retroactively invented, because tracked-device blocking without a reconciled baseline would stop trading."}, {"id": "recommerce_migration_plan_gate_0_provider_containment", "label": "Gate 0 \u2014 Provider Containment and Runtime Baseline", "file_type": "concept", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The current local package cannot provide runtime proof because PHP is unavailable and module sources are incomplete."}, {"id": "recommerce_migration_plan_data_discovery", "label": "Sanitized Production Data Discovery", "file_type": "concept", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free-text serial notes are hints, not automatically trusted device identities."}, {"id": "recommerce_migration_plan_phase_a_foundation", "label": "Phase A \u2014 Foundation, Inactive", "file_type": "concept", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_migration_plan_phase_b_backfill", "label": "Phase B \u2014 Read-Only Backfill", "file_type": "concept", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_migration_plan_phase_c_one_location_alpha", "label": "Phase C \u2014 One-Location Alpha Write Path", "file_type": "concept", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Undocumented alternate receipt paths are prohibited for the scoped profile, otherwise reconciliation cannot attribute a mismatch."}, {"id": "recommerce_migration_plan_phase_d_sales_transfers_repair", "label": "Phase D \u2014 Sales, Transfers and Repair", "file_type": "concept", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_migration_plan_legacy_inventory_strategy", "label": "Legacy Inventory Profile Strategy", "file_type": "rationale", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "legacy_unserialized_qty = POS qty_available \u2212 verified tracked on-hand devices; activation is blocked when that is negative, fractional or unexplained, and fake serials are never mass-generated."}, {"id": "recommerce_migration_plan_identity_backfill_dedup", "label": "Identity Backfill and Deduplication", "file_type": "concept", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identity is never inferred from product, customer, date or an identical free-text note; a human reviewer approves each conflict resolution."}, {"id": "recommerce_migration_plan_legacy_repair_migration", "label": "Legacy Repair Module Migration Options", "file_type": "rationale", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preference order is lossless migration, then read-only historical deep links, then archive/export; never run both modules as writable authorities for the same job or device."}, {"id": "recommerce_migration_plan_pos_integration_deployment", "label": "Narrow POS Guard Deployment", "file_type": "concept", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guards deploy inactive first and log 'would block' results so false positives can be compared before enforcement."}, {"id": "recommerce_migration_plan_cutover_runbook", "label": "Per-Cohort Cutover Runbook", "file_type": "concept", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_migration_plan_rollback", "label": "Feature Rollback Policy", "file_type": "rationale", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rollback disables commands and returns to LEGACY_MIXED without deleting device, movement, job, cost or event history; a database restore is disaster recovery, not feature rollback, because it can erase valid POS activity."}, {"id": "recommerce_migration_plan_reconciliation_checks", "label": "Migration Reconciliation Checks", "file_type": "concept", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Severity-one mismatches stop cohort expansion and daily signed exception reports are required through Alpha."}, {"id": "recommerce_migration_plan_testing_layers", "label": "Migration Testing Layers", "file_type": "concept", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a712", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HTTP success or migration completion is not acceptance; rendered UI, persisted records, stock equality and role denial must be observed."}, {"id": "recommerce_migration_plan_operational_readiness", "label": "Operational Readiness Checklist", "file_type": "concept", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_migration_plan_acceptance_evidence", "label": "Per-Cohort Acceptance Evidence", "file_type": "concept", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a714", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_migration_plan_explicit_non_actions", "label": "Explicit Non-Actions", "file_type": "concept", "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a715", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "recommerce_migration_plan_gate_0_provider_containment", "target": "recommerce_architecture_provider_repair_containment", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a72", "weight": 1.0}, {"source": "recommerce_migration_plan_gate_0_provider_containment", "target": "recommerce_roadmap_gate_0", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "RECOMMERCE_MIGRATION_PLAN.md", "source_location": "\u00a72", "weight": 1.0}, {"source": "recommerce_migration_plan_legacy_inventory_strategy", "target": "recommerce_architecture_serialization_profiles", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": 