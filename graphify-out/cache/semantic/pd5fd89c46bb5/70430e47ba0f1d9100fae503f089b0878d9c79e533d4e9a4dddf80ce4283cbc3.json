{"nodes": [{"id": "docs_tradein_intelligence_release_increment", "label": "Integrated Trade-In Staging Increment (8 Sept 2026)", "file_type": "document", "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implements shared exact-variant quoting, governed evidence import, native inventory signals, bounded policy adjustments and PHP resale modelling without activating any customer pricing; production is unchanged."}, {"id": "docs_tradein_intelligence_release_import_contract", "label": "Governed Import Contract {kind,target,data}", "file_type": "concept", "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Versioned, tenant scoped, capped at 250 observations / 1MB; source URLs are validated against an explicit HTTPS host allowlist and never fetched, so an import adapter never implies a licensed connector."}, {"id": "docs_tradein_intelligence_release_kind_variant", "label": "VARIANT import kind", "file_type": "concept", "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_tradein_intelligence_release_kind_reference", "label": "REFERENCE import kind", "file_type": "concept", "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No model-level reference is silently expanded to a variant; Galaxy S22 RM1,500 and iPad 9 RM1,050 remain incomplete model-level references."}, {"id": "docs_tradein_intelligence_release_kind_policy", "label": "POLICY import kind", "file_type": "concept", "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commercial amounts use integer sen; a reference condition with a nonzero duplicate condition deduction is rejected and no commercial defaults are auto-approved for phones/tablets."}, {"id": "docs_tradein_intelligence_release_kind_source", "label": "SOURCE import kind", "file_type": "concept", "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires registering actual licence scope (permission_status, retention_days, allowed_hosts, access_method) before any observation import."}, {"id": "docs_tradein_intelligence_release_kind_observations", "label": "OBSERVATIONS import kind", "file_type": "concept", "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shipping and mandatory fees stay null when unknown; observation times normalize to UTC without becoming newly observed, and private raw evidence is never sent to the website."}, {"id": "docs_tradein_intelligence_release_market_processing", "label": "Market Evidence Processing and Confidence Tiers", "file_type": "concept", "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dedup by listing/variant, duplicate groups and one listing per independent seller stops repeated observations inflating the sample; HIGH needs ten sellers/listings, two upstream platforms, seven-day freshness and acceptable IQR. Single-source can never be HIGH. Extreme prices are flagged and retained, not deleted. These are engineering heuristics, not calibrated accuracy claims."}, {"id": "docs_tradein_intelligence_release_demand_signals", "label": "Native Demand Signals Projection", "file_type": "concept", "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only over final unreversed sales and owned AVAILABLE/ON_HAND/LOCATION devices; demo/QA estates excluded and unknowns stay unknown so commercial effects remain neutral. Exactly one bounded delta may apply, and no adjustment policy is approved in this release."}, {"id": "docs_tradein_intelligence_release_resale_model", "label": "PHP Resale Model log-residual-condition-storage-2", "file_type": "concept", "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fits log resale-price residuals against the stored deterministic reference and deliberately excludes unknown age/RAM rather than inventing values; device-level separation and chronological splits prevent leakage, dataset SHA and fixed hyperparameters make training reproducible, and candidates stay SHADOW until an explicit promotion with audit event."}, {"id": "docs_tradein_intelligence_release_migration_table", "label": "recommerce_trade_in_intelligence table", "file_type": "concept", "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_tradein_intelligence_release_scheduled_command", "label": "recommerce:tradein-intelligence scheduled command", "file_type": "code", "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs every five minutes with --limit=3 when staging jobs are enabled; requests coalesce, attempts cap at three, failures are classified without raw private diagnostics, and customer requests never trigger training/collection jobs."}, {"id": "docs_tradein_intelligence_release_pricing_flags", "label": "Independent Pricing Flags (MARKET/DEMAND/MODEL_PRICING_ENABLED)", "file_type": "concept", "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All three default false and are independent, so no pricing lane can be activated as a side effect of another."}, {"id": "docs_tradein_intelligence_release_backup_gate", "label": "Pre-Migration mysqldump Backup Gate", "file_type": "rationale", "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bootstrap requires a successful private mysqldump with verified compression hash, stored outside public/ under storage/app/private/staging-backups; a missing utility or permission aborts before migration. Archive integrity alone is explicitly not a restore test."}, {"id": "docs_tradein_intelligence_release_nogo_decision", "label": "NO-GO Production Release Decision", "file_type": "rationale", "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero verified operational market sources, no approved exact phone/tablet variant policies, no validated stock-exposure dataset and no promoted production model; engineering tests are not a substitute for these inputs."}, {"id": "docs_tradein_intelligence_release_release_manifest", "label": "storage/app/tradein-release.json commit manifest", "file_type": "concept", "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The authenticated workspace checks actual runtime file hashes against this manifest, so a partial or stale deploy is detectable."}], "edges": [{"source": "docs_tradein_intelligence_release_increment", "target": "docs_tradein_intelligence_release_import_contract", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_tradein_intelligence_release_import_contract", "target": "docs_tradein_intelligence_release_kind_variant", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_tradein_intelligence_release_import_contract", "target": "docs_tradein_intelligence_release_kind_reference", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_tradein_intelligence_release_import_contract", "target": "docs_tradein_intelligence_release_kind_policy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_tradein_intelligence_release_import_contract", "target": "docs_tradein_intelligence_release_kind_source", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_tradein_intelligence_release_import_contract", "target": "docs_tradein_intelligence_release_kind_observations", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_tradein_intelligence_release_kind_observations", "target": "docs_tradein_intelligence_release_market_processing", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_tradein_intelligence_release_kind_source", "target": "docs_tradein_intelligence_release_kind_observations", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_tradein_intelligence_release_increment", "target": "docs_tradein_intelligence_release_demand_signals", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_tradein_intelligence_release_increment", "target": "docs_tradein_intelligence_release_resale_model", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_tradein_intelligence_release_increment", "target": "docs_tradein_intelligence_release_migration_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_tradein_intelligence_release_backup_gate", "target": "docs_tradein_intelligence_release_migration_table", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_tradein_intelligence_release_scheduled_command", "target": "docs_tradein_intelligence_release_market_processing", "relation": "calls", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/tradein-intelligence/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_tradein_intelligence_release_pricing_flags", "target": "docs_tradein_intelligence_release_resale_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file"