{"nodes": [{"id": "docs_customer_projection_v1_api", "label": "Customer Projection V1 API", "file_type": "document", "source_file": "docs/CUSTOMER_PROJECTION_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dedicated read-only surface for the SaverBro web connector rather than a staff route or generic query endpoint, so customer exposure is narrow by construction."}, {"id": "docs_customer_projection_v1_listings_endpoint", "label": "GET /api/customer-projection/v1/listings", "file_type": "concept", "source_file": "docs/CUSTOMER_PROJECTION_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pagination metadata carries page counts only, never database IDs or offsets, so enumeration of internal identifiers is impossible."}, {"id": "docs_customer_projection_v1_discovery_contract", "label": "Discovery Contract (customer-safe filters)", "file_type": "concept", "source_file": "docs/CUSTOMER_PROJECTION_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only category, brand, model_slug, cpu, ram, storage, branch, min_price, max_price, sort and bounded page/per_page (max 48) are accepted, keeping the endpoint from becoming a generic query surface."}, {"id": "docs_customer_projection_v1_sellability_gate", "label": "Operational Sellability and Merchandising Gate", "file_type": "rationale", "source_file": "docs/CUSTOMER_PROJECTION_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Device is exposed only when both operationally sellable (AVAILABLE, LOCATION custody, ON_HAND, no transfer, no sale, correct cohort) and explicitly merchandised (PUBLISHED, positive exact price, public Device ID, model slug, public specification ID); two independent gates prevent accidental publication."}, {"id": "docs_customer_projection_v1_passport", "label": "V1 Passport (inspection presence only)", "file_type": "concept", "source_file": "docs/CUSTOMER_PROJECTION_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reports unrecorded condition, battery, defects, refurbishment and warranty facts as unavailable rather than fabricating them, and deliberately does not reuse the post-sale certification record."}, {"id": "docs_customer_projection_v1_bearer_token", "label": "RECOMMERCE_CUSTOMER_PROJECTION_BEARER_TOKEN", "file_type": "concept", "source_file": "docs/CUSTOMER_PROJECTION_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_customer_projection_v1_enabled_flag", "label": "RECOMMERCE_CUSTOMER_PROJECTION_ENABLED", "file_type": "concept", "source_file": "docs/CUSTOMER_PROJECTION_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_customer_projection_v1_neutral_unavailable", "label": "Neutral Unavailable Response", "file_type": "rationale", "source_file": "docs/CUSTOMER_PROJECTION_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A disabled or invalid connector is neutral and unavailable, never represented as empty inventory, so a misconfiguration cannot be mistaken for a genuine sold-out catalogue."}], "edges": [{"source": "docs_customer_projection_v1_api", "target": "docs_customer_projection_v1_listings_endpoint", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/CUSTOMER_PROJECTION_V1.md", "source_location": null, "weight": 1.0}, {"source": "docs_customer_projection_v1_listings_endpoint", "target": "docs_customer_projection_v1_discovery_contract", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "sou