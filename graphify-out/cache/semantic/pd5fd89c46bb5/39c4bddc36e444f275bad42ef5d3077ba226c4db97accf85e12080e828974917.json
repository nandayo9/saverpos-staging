{"nodes": [{"id": "rcr_011_stock_count_v1", "label": "RCR-011 Stock Count V1", "file_type": "document", "source_file": "RCR_011_STOCK_COUNT_V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_011_stock_count_v1_boundary", "label": "Stock Count Evidence-Only Boundary", "file_type": "rationale", "rationale": "Count rows are an immutable physical observation and evidence, never a second stock ledger: UltimatePOS stays authoritative for catalogue, aggregate quantity, transactions and accounting, and Recommerce for exact Device, lifecycle, ownership, custody and history.", "source_file": "RCR_011_STOCK_COUNT_V1.md", "source_location": "Boundary", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_011_stock_count_v1_workflow", "label": "Stock Count Workflow States", "file_type": "concept", "rationale": "DRAFT to IN_PROGRESS to REVIEW to AWAITING_APPROVAL to RECONCILED to CLOSED. Starting creates immutable Device and generic-variation snapshot rows; a scan may create an exception but never changes Device lifecycle, custody or ownership, and every successful Device scan is unique per session.", "source_file": "RCR_011_STOCK_COUNT_V1.md", "source_location": "V1 workflow", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_011_stock_count_v1_reconciliation_policy", "label": "Stock Count Reconciliation Policy", "file_type": "rationale", "rationale": "Only an approved negative non-serialized variance reconciles, through UltimatePosStockCountAdjustmentWriter and a native stock_adjustment transaction. Positive variance is blocked because stock cannot be created without receiving, return or identity provenance, and serialized discrepancies are blocked from automatic reconciliation so correction goes through the existing sale/return/transfer/repair flows.", "source_file": "RCR_011_STOCK_COUNT_V1.md", "source_location": "Reconciliation policy", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_011_stock_count_v1_adjustment_writer", "label": "UltimatePosStockCountAdjustmentWriter", "file_type": "concept", "rationale": "Creates a native stock_adjustment transaction and calls UltimatePOS ProductUtil; it never updates variation_location_details directly, preserving core posting semantics.", "source_file": "RCR_011_STOCK_COUNT_V1.md", "source_location": "Reconciliation policy", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_011_stock_count_v1_exception_matrix", "label": "Stock Count Exception Matrix", "file_type": "concept", "rationale": "Missing Device, Unexpected Device, Wrong Location, Wrong State and Serialized aggregate conflict all resolve to no automatic stock, custody or lifecycle mutation; only an approved negative generic quantity variance mutates aggregate stock.", "source_file": "RCR_011_STOCK_COUNT_V1.md", "source_location": "Exception matrix", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_011_stock_count_v1_deliberate_limits", "label": "Deliberate V1 Limits", "file_type": "rationale", "rationale": "No count zones, recount rounds, live-movement adjustments, positive quantity adjustments or generic Device state controls; any post-snapshot tracked Device movement is visible and blocks reconciliation, requiring a fresh count until a movement-aware policy is designed and tested. Browser interaction is explicitly not claimed.", "source_file": "RCR_011_STOCK_COUNT_V1.md", "source_location": "Deliberate V1 limits", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "rcr_011_stock_count_v1", "target": "rcr_011_stock_count_v1_boundary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_011_STOCK_COUNT_V1.md", "source_location": "Boundary", "weight": 1.0}, {"source": "rcr_011_stock_count_v1", "target": "rcr_011_stock_count_v1_workflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_011_STOCK_COUNT_V1.md", "source_location": "V1 workflow", "weight": 1.0}, {"source": "rcr_011_stock_count_v1", "target": "rcr_011_stock_count_v1_reconciliation_policy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_011_STOCK_COUNT_V1.md", "source_location": "Reconciliation policy", "weight": 1.0}, {"source": "rcr_011_stock_count_v1", "target": "rcr_011_stock_count_v1_exception_matrix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_011_STOCK_COUNT_V1.md", "source_location": "Exception matrix", "weight": 1.0}, {"source": "rcr_011_stock_count_v1", "target": "rcr_011_stock_count_v1_deliberate_limits", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_011_STOCK_COUNT_V1.md", "source_location": "Deliberate V1 limits", "weight": 1.0}, {"source": "rcr_011_stock_count_v1_reconciliation_policy", "target": "rcr_011_stock_count_v1_adjustment_writer", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_011_STOCK_COUNT_V1.md", "source_location": "Reconciliation policy", "weight": 1.0}, {"source": "rcr_011_stock_count_v1_reconciliation_policy", "target": "rcr_011_stock_count_v1_exception_matrix", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_011_STOCK_COUNT_V1.md", "source_location": "Exception matrix", "weight": 1.0}, {"source": "rcr_011_stock_count_v1_boundary", "target": "rcr_008_device_lifecycle_assessment_authority_split", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "RCR_011_STOCK_COUNT_V1.md", "source_location": "Boundary", "weight": 1.0}, {"source": "rcr_011_stock_count_v1_adjustment_writer", "target": "rcr_0