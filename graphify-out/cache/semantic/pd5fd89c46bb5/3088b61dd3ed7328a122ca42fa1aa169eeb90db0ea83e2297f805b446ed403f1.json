{"nodes": [{"id": "recommerce_workflows_document", "label": "SaverBro Recommerce OS Workflows", "file_type": "document", "source_file": "RECOMMERCE_WORKFLOWS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_workflows_mutating_command_contract", "label": "Seven-Step Mutating Command Contract", "file_type": "rationale", "source_file": "RECOMMERCE_WORKFLOWS.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No user may directly edit ownership, custody, lifecycle or stock state; those values change only through authorized, locked, idempotent commands."}, {"id": "recommerce_workflows_device_lifecycle_state_machine", "label": "Device Lifecycle State Machine", "file_type": "concept", "source_file": "RECOMMERCE_WORKFLOWS.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forbidden transitions such as SOLD \u2192 IN_STOCK without a return/trade-in, or IN_TRANSFER \u2192 SOLD, exist to stop the ledger implying two active custody locations."}, {"id": "recommerce_workflows_purchase_linked_receiving", "label": "Purchase-Linked Serialized Receiving", "file_type": "concept", "source_file": "RECOMMERCE_WORKFLOWS.md", "source_location": "\u00a73.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A duplicate manufacturer identifier stops that unit, not the whole prepared batch, so a single bad scan does not discard verified work."}, {"id": "recommerce_workflows_trade_in_intake", "label": "Trade-In Intake", "file_type": "concept", "source_file": "RECOMMERCE_WORKFLOWS.md", "source_location": "\u00a73.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scan searches the canonical registry first and reuses an existing device row rather than creating a replacement identity; acquisition value must go through POS/accounting, not only the Recommerce ledger."}, {"id": "recommerce_workflows_scan_and_lookup", "label": "Scan and Lookup Resolution Order", "file_type": "concept", "source_file": "RECOMMERCE_WORKFLOWS.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ambiguous partial matches never auto-open a record and revoked tokens do not reveal whether a device exists."}, {"id": "recommerce_workflows_internal_refurbishment", "label": "Internal Refurbishment Workflow", "file_type": "concept", "source_file": "RECOMMERCE_WORKFLOWS.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_workflows_customer_repair_service", "label": "Customer Repair Service Workflow", "file_type": "concept", "source_file": "RECOMMERCE_WORKFLOWS.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No billable work proceeds beyond an explicitly authorized diagnostic allowance until an approval captures quote version, channel and evidence."}, {"id": "recommerce_workflows_parts_lifecycle", "label": "Parts Lifecycle and Stock Effects", "file_type": "concept", "source_file": "RECOMMERCE_WORKFLOWS.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reversal is an explicit POS return/adjustment that appends a compensating cost row; the original cost entry is never edited."}, {"id": "recommerce_workflows_tracked_device_sale", "label": "Sale of a Tracked Device", "file_type": "concept", "source_file": "RECOMMERCE_WORKFLOWS.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Finalization is rejected when a tracked variation lacks a device assignment; cancelling uses an explicit inverse workflow and never