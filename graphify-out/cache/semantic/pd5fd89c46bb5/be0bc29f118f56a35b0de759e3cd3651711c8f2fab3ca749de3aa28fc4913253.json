{"nodes": [{"id": "recommerce_data_model_document", "label": "SaverBro Recommerce OS Data Model", "file_type": "document", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_conventions", "label": "Schema Conventions", "file_type": "rationale", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eloquent morphs are avoided for integrity-critical financial/device links because polymorphic keys cannot carry a database-level exactly-one-target invariant; explicit nullable FKs are used instead."}, {"id": "recommerce_data_model_recommerce_devices", "label": "recommerce_devices", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Devices are retired, never soft-deleted, so history and identity survive; grade_id and manufacturer_serial_display are caches over authoritative child rows."}, {"id": "recommerce_data_model_recommerce_device_identifiers", "label": "recommerce_device_identifiers", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Placeholder values such as N/A or all zeroes must be stored as null/notes so they never collide under the tenant-wide uniqueness constraint; a manager merge workflow resolves duplicates rather than bypassing uniqueness."}, {"id": "recommerce_data_model_recommerce_device_ownership_periods", "label": "recommerce_device_ownership_periods", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_recommerce_device_attribute_snapshots", "label": "recommerce_device_attribute_snapshots", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_recommerce_scan_tokens", "label": "recommerce_scan_tokens", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the token hash is stored and the plain token is returned once at issue/print, so a database read cannot reconstruct a working QR."}, {"id": "recommerce_data_model_recommerce_label_jobs", "label": "recommerce_label_jobs", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_recommerce_label_job_items", "label": "recommerce_label_job_items", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_recommerce_serialization_profiles", "label": "recommerce_serialization_profiles", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_recommerce_legacy_stock_balances", "label": "recommerce_legacy_stock_balances", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_recommerce_device_purchase_assignments", "label": "recommerce_device_purchase_assignments", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_recommerce_device_sale_assignments", "label": "recommerce_device_sale_assignments", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An active unique device assignment is what physically prevents the same unit being sold twice."}, {"id": "recommerce_data_model_recommerce_device_movements", "label": "recommerce_device_movements", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_recommerce_stock_commands", "label": "recommerce_stock_commands", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reusing a command UUID with a different request hash is rejected, so idempotency cannot be abused to smuggle a different mutation."}, {"id": "recommerce_data_model_recommerce_repair_jobs", "label": "recommerce_repair_jobs", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "access_required is a boolean only; a device password is never stored on the job row."}, {"id": "recommerce_data_model_recommerce_repair_state_transitions", "label": "recommerce_repair_state_transitions", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_recommerce_repair_assignments", "label": "recommerce_repair_assignments", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_recommerce_repair_access_secrets", "label": "recommerce_repair_access_secrets", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default Alpha policy is do-not-store: customer-present unlock, a temporary code destroyed immediately, or a customer-managed reset avoids holding a credential at all."}, {"id": "recommerce_data_model_recommerce_repair_accessories", "label": "recommerce_repair_accessories", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Structured accessory rows exist so a free-text list cannot lose collection accountability."}, {"id": "recommerce_data_model_recommerce_diagnostic_templates", "label": "recommerce_diagnostic_templates", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Published template versions are immutable so past diagnostic evidence keeps its meaning."}, {"id": "recommerce_data_model_recommerce_diagnostic_sessions", "label": "recommerce_diagnostic_sessions", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_recommerce_diagnostic_observations", "label": "recommerce_diagnostic_observations", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Battery health lives as check keys on observations rather than nullable device columns, so the device table does not grow a column per measurable attribute; projections are added only after evidence shows a need."}, {"id": "recommerce_data_model_recommerce_grade_assignments", "label": "recommerce_grading_schemes / grades / grade_assignments", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_recommerce_faults", "label": "recommerce_faults", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_recommerce_repair_actions", "label": "recommerce_repair_actions", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_recommerce_part_usages", "label": "recommerce_part_usages", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A part usage has exactly one inventory posting strategy/source so the same physical part cannot be decremented through both a sale line and a stock adjustment."}, {"id": "recommerce_data_model_recommerce_repair_quotes", "label": "recommerce_repair_quotes", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Issued versions are immutable and superseded rather than edited, so an approval always points at exactly the commercial terms the customer saw."}, {"id": "recommerce_data_model_recommerce_repair_quote_lines", "label": "recommerce_repair_quote_lines", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_recommerce_repair_approvals", "label": "recommerce_repair_approvals", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Approval is never overwritten; any quoted commercial change forces a new version and a fresh approval record with its own evidence."}, {"id": "recommerce_data_model_recommerce_qc_sessions", "label": "recommerce_qc_sessions", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_recommerce_repair_warranty_entitlements", "label": "recommerce_repair_warranty_entitlements", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A claim creates a new linked repair job rather than rewriting the closed original job, preserving the original evidence."}, {"id": "recommerce_data_model_recommerce_cost_entries", "label": "recommerce_cost_entries", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Profit views use only POSTED entries net of reversals while ESTIMATED rows remain available for quote variance analysis."}, {"id": "recommerce_data_model_recommerce_events", "label": "recommerce_events", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_recommerce_outbox_messages", "label": "recommerce_outbox_messages", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_recommerce_reconciliation_runs", "label": "recommerce_reconciliation_runs / issues", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolution records evidence but never silently changes stock."}, {"id": "recommerce_data_model_state_constraints", "label": "Fifteen State Constraints / Invariants", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_data_model_identifier_normalization", "label": "Identifier Normalization Rules", "file_type": "concept", "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a712", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never apply a transformation that can collapse legitimately different serials without a raw-value review, and never run partial/fuzzy matching for a mutation."}], "edges": [{"source": "recommerce_architecture_canonical_physical_device", "target": "recommerce_data_model_recommerce_devices", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a73", "weight": 1.0}, {"source": "recommerce_architecture_ownership_custody_lifecycle_separation", "target": "recommerce_data_model_recommerce_device_ownership_periods", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RECOMMERCE_DATA_MODEL.md", "source_location": "\u00a73", "weight": 1.0}, {"source": "recommerce_architecture_serialization_profiles"