{"nodes": [{"id": "rcr_008_device_lifecycle_assessment", "label": "RCR-008 Device Lifecycle Technical Assessment", "file_type": "document", "source_file": "RCR_008_DEVICE_LIFECYCLE_ASSESSMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_008_device_lifecycle_assessment_integration_points", "label": "Controlled Lifecycle Integration Points", "file_type": "concept", "rationale": "The lifecycle service is invoked from sell store/update/delete, sell return store/delete, and completed stock transfers, always after core lines exist and before the surrounding controller transaction commits, so an invalid device selection rolls the core transaction back too. Pending transfers deliberately do not move custody.", "source_file": "RCR_008_DEVICE_LIFECYCLE_ASSESSMENT.md", "source_location": "Controlled integration points", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_008_device_lifecycle_assessment_locking_idempotency", "label": "Transaction, Locking and Idempotency Design", "file_type": "rationale", "rationale": "The service locks the sale/transfer/return row and each selected Device row, validates scope and lifecycle from persisted records, writes unique append-only disposition rows, and uses recommerce_stock_commands for command idempotency. Database uniqueness prevents more than one active disposition of a kind, and there is no silent legacy bypass: selection applies only to variations with an approved serialization profile inside the enabled cohort.", "source_file": "RCR_008_DEVICE_LIFECYCLE_ASSESSMENT.md", "source_location": "Transaction, locking, and idempotency design", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_008_device_lifecycle_assessment_certification_defect", "label": "DeviceCertificationService sold_at Defect", "file_type": "concept", "rationale": "DeviceCertificationService requires sold_at, but normal sales do not set it; recorded as a real lifecycle defect rather than a documentation gap.", "source_file": "RCR_008_DEVICE_LIFECYCLE_ASSESSMENT.md", "source_location": "Verified implementation state", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_008_device_lifecycle_assessment_authority_split", "label": "Core vs Recommerce Authority Split", "file_type": "rationale", "rationale": "variation_location_details, sales, purchases, payments, tax, cash, accounting, FIFO/LIFO mapping and warranty rules remain Ultimate POS authority; Recommerce stores only device identity, disposition history, custody/ownership history and a derived economics projection. Non-cohort and aggregate-only variations keep current behaviour.", "source_file": "RCR_008_DEVICE_LIFECYCLE_ASSESSMENT.md", "source_location": "What remains untouched", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_008_device_lifecycle_assessment_fixture_gap", "label": "Disposable Fixture Bootstrap Gap", "file_type": "concept", "rationale": "The checked-in .env selects /private/tmp/saverbro_recommerce_demo.sqlite, which does not exist. PHPUnit stays reproducible via in-memory SQLite in phpunit.xml, but the browser/runtime fixture needs an explicit disposable bootstrap path before it can be claimed operational.", "source_file": "RCR_008_DEVICE_LIFECYCLE_ASSESSMENT.md", "source_location": "Known runtime condition before this change", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "rcr_008_device_lifecycle_assessment", "target": "rcr_008_device_lifecycle_assessment_integration_points", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_008_DEVICE_LIFECYCLE_ASSESSMENT.md", "source_location": "Controlled integration points", "weight": 1.0}, {"source": "rcr_008_device_lifecycle_assessment", "target": "rcr_008_device_lifecycle_assessment