{"nodes": [{"id": "rcr_008_tracked_device_pilot_runbook", "label": "RCR-008 Tracked Device Pilot Runbook", "file_type": "document", "source_file": "RCR_008_TRACKED_DEVICE_PILOT_RUNBOOK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_008_tracked_device_pilot_runbook_preflight", "label": "Pilot Pre-Flight", "file_type": "concept", "rationale": "An isolated migrated database, module and writes enabled only for the approved business/branch/variation, the five device permissions assigned to the pilot role, a signed physical baseline that reconciles, and a confirmed keyboard-wedge scanner and label printer path.", "source_file": "RCR_008_TRACKED_DEVICE_PILOT_RUNBOOK.md", "source_location": "Pre-flight", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_008_tracked_device_pilot_runbook_operating_procedure", "label": "Pilot Operating Procedure", "file_type": "concept", "rationale": "One receive and label per unit, no sale of RECEIVED/repair/quarantine devices, device codes entered per transfer unit with status-only completion intentionally blocked for tracked stock, one code per tracked sale unit with a whole-transaction failure on any invalid selection, returns defaulting to RETURNED_PENDING_INSPECTION, void/delete through native core actions only, and reconciliation at opening, close and after each discrepancy.", "source_file": "RCR_008_TRACKED_DEVICE_PILOT_RUNBOOK.md", "source_location": "Operating procedure", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_008_tracked_device_pilot_runbook_discrepancy_escalation", "label": "Discrepancy Escalation and Pilot Rollback", "file_type": "rationale", "rationale": "Never create or delete Devices to force a reconciliation pass: stop the affected variation, preserve the core transaction and Recommerce events, escalate with the reconciliation run ID, and correct only through an audited reversal/inspection workflow. Rollback reconciles and closes outstanding operations, sets RECOMMERCE_WRITES_ENABLED=false, keeps reads on until evidence is exported, and disables the module only after a final retained reconciliation.", "source_file": "RCR_008_TRACKED_DEVICE_PILOT_RUNBOOK.md", "source_location": "Discrepancy escalation and rollback", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "rcr_008_tracked_device_pilot_runbook", "target": "rcr_008_tracked_device_pilot_runbook_preflight", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_008_TRACKED_DEVICE_PILOT_RUNBOOK.md", "source_location": "Pre-flight", "weight": 1.0}, {"source": "rcr_008_tracked_device_pilot_runbook", "target": "rcr_008_tracked_device_pilot_runbook_operating_procedure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_008_TRACKED_DEVICE_PILOT_RUNBOOK.md", "source_location": "Operating procedure", "weight": 1.0}, {"source": "rcr_008_tracked_device_pilot_runbook", "target": "rcr_008_tracked_device_pilot_runbook_discrepancy_escalation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_008_TRACKED_DEVICE_PILOT_RUNBOOK.md", "source_location": "Discrepancy escalation and rollback", "weight": 1.0}, {"source": "rcr_008_tracked_device_pilot_runbook_preflight", "target": "rcr_008_device_lifecycle_assessment_fixture_gap", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "RCR_008_TRACKED_DEVICE_PILOT_RUNBOOK.md", "source_location": "Pre-flight", "weight": 1.0}, {"source": "rcr_008_tracked_device_pilot_runbook_operating_procedure", "target": "rcr_008_device_lifecycle_assessment_integration_points", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "RCR_008_TRACKED_DEVICE_PILOT_RUNBOOK.md", "source_location": "Ope