{"nodes": [{"id": "rcr_007_provider_repair_containment", "label": "RCR-007 Provider Repair Containment Audit", "file_type": "document", "source_file": "RCR_007_PROVIDER_REPAIR_CONTAINMENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_007_provider_repair_containment_owned_repair_decision", "label": "SaverBro-Owned Repair Under Modules/Recommerce", "file_type": "rationale", "rationale": "The unavailable provider Modules/Repair will not be the writable Repair authority; the owned Repair domain is built under Modules/Recommerce on the canonical Recommerce Device. Provider recovery is not required to build new capability and matters only if a live deployment holds legacy Repair data to preserve, migrate or archive.", "source_file": "RCR_007_PROVIDER_REPAIR_CONTAINMENT.md", "source_location": "Section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_007_provider_repair_containment_legacy_containment_risk", "label": "Legacy Containment Risk Reclassification", "file_type": "rationale", "rationale": "The provider dependency is reclassified from a blocker into a legacy containment risk: it no longer blocks designing or implementing owned Repair, while the runtime baseline, approved data profile and browser/POS regression proof remain open.", "source_file": "RCR_007_PROVIDER_REPAIR_CONTAINMENT.md", "source_location": "Section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_007_provider_repair_containment_required_work", "label": "Required Containment Work", "file_type": "concept", "rationale": "Run the baseline with provider Repair disabled and stale cache regenerated, prove boot and ordinary POS flows need no provider classes, decide legacy receipt/view/row behavior, keep owned Repair outside legacy repair subtype/tables/routes/fields, and add a regression test that Recommerce boots with no Modules\\Repair class resolution.", "source_file": "RCR_007_PROVIDER_REPAIR_CONTAINMENT.md", "source_location": "Section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_007_provider_repair_containment_repair_jobs_model", "label": "Shared repair_jobs Model", "file_type": "concept", "rationale": "One shared repair_jobs model supports both INTERNAL_REFURBISHMENT and CUSTOMER_REPAIR, bound to the canonical Device where a physical device exists, with Ultimate POS retaining contacts, catalogue, stock, sales, invoices, payments and accounting authority.", "source_file": "RCR_007_PROVIDER_REPAIR_CONTAINMENT.md", "source_location": "Section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "rcr_007_provider_repair_containment", "target": "rcr_007_provider_repair_containment_owned_repair_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_007_PROVIDER_REPAIR_CONTAINMENT.md", "source_location": "Section 1", "weight": 1.0}, {"source": "rcr_007_provider_repair_containment", "target": "rcr_007_provider_repair_containment_required_work", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_007_PROVIDER_REPAIR_CONTAINMENT.md", "source_location": "Section 3", "weight": 1.0}, {"source": "rcr_007_provider_repair_containment", "target": "rcr_007_provider_repair_containment_repair_jobs_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_007_PROVIDER_REPAIR_CONTAINMENT.md", "source_location": "Section 4", "weight": 1.0}, {"source": "rcr_007_provider_repair_containment", "target": "rcr_007_provider_repair_containment_legacy_containment_risk", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_007_PROVIDER_REPAIR_CONTAINMENT.md", "source_location": "Section 5", "weight": 1.0}, {"source": "rcr_007_provider_repa