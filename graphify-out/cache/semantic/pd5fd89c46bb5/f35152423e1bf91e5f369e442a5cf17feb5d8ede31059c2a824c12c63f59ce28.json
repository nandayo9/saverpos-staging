{"nodes": [{"id": "icore_cpanel_staging_runbook", "label": "SAVERPOS Staging on iCore cPanel Runbook", "file_type": "document", "source_file": "ICORE_CPANEL_STAGING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Publishes a fictional team-test estate on an isolated MySQL database; explicitly not a production deployment."}, {"id": "icore_cpanel_staging_host", "label": "pos.kkcctv.com.my staging host", "file_type": "concept", "source_file": "ICORE_CPANEL_STAGING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "icore_cpanel_staging_managed_checkout", "label": "Managed Git Checkout (saverpos-staging-repo)", "file_type": "concept", "source_file": "ICORE_CPANEL_STAGING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept separate from the live directory so cPanel Let's Encrypt files and the server-only .env never dirty the checkout \u2014 cPanel greys out Deploy whenever the branch has uncommitted or untracked changes."}, {"id": "icore_cpanel_staging_live_runtime", "label": "Live Runtime Directory (saverpos-staging)", "file_type": "concept", "source_file": "ICORE_CPANEL_STAGING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds the server-only .env and the published result, with vendor, bootstrap and storage linked back to the checkout; the subdomain document root points at its public/ directory."}, {"id": "icore_cpanel_staging_deploy_script", "label": "scripts/cpanel-staging-deploy.sh", "file_type": "code", "source_file": "ICORE_CPANEL_STAGING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Finds PHP 8.2, installs a checksum-verified local Composer when no global one exists, prepares writable directories, generates an app key only when missing, migrates the isolated database and seeds the demo fixture only when no business exists."}, {"id": "icore_cpanel_staging_poll_script", "label": "scripts/cpanel-staging-poll.sh Cron Poller", "file_type": "code", "source_file": "ICORE_CPANEL_STAGING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-local five-minute poller that accepts only a fast-forward advance of origin/staging and uses a lock to prevent overlapping Composer/database work; chosen over GitHub Actions because an anti-bot challenge protects the cPanel UAPI."}, {"id": "icore_cpanel_staging_env", "label": "Staging .env (APP_ENV=staging, Recommerce cohort IDs)", "file_type": "concept", "source_file": "ICORE_CPANEL_STAGING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Created only in the live directory from .env.cpanel-staging.example with the DB password typed directly in cPanel; the first deployment generates APP_KEY there and the local key is never reused."}, {"id": "icore_cpanel_staging_demo_seeder", "label": "SaverposDemoRuntimeSeeder", "file_type": "code", "source_file": "ICORE_CPANEL_STAGING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creates a fictional account, business, two branches, one tracked variation and one Device, and will not reseed if a business already exists."}, {"id": "icore_cpanel_staging_smoke_test", "label": "Staging Smoke Test and 2026-08-30 Live Result", "file_type": "concept", "source_file": "ICORE_CPANEL_STAGING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serialized receiving, A-to-B transfer, POS sale, exact-device return and reconciliation passed; the Cash button failed only because Branch B has no cash entry in default_payment_accounts. This is runtime evidence for the isolated demo estate, not production certification."}], "edges": [{"source": "icore_cpanel_staging_runbook", "target": "icore_cpanel_staging_host", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ICORE_CPANEL_STAGING.md", "source_location": null, "weight": 1.0}, {"source": "icore_cpanel_staging_managed_checkout", "target": "icore_cpanel_staging_live_runtime", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ICORE_CPANEL_STAGING.md", "source_location": null, "weight": 1.0}, {"source": "icore_cpanel_staging_live_runtime", "target": "icore_cpanel_staging_host", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ICORE_CPANEL_STAGING.md", "source_location": null, "weight": 1.0}, {"source": "icore_cpanel_staging_poll_script", "target": "icore_cpanel_staging_deploy_script", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ICORE_CPANEL_STAGING.md", "source_location": null, "weight": 1.0}, {"source": "icore_cpanel_staging_poll_script", "target": "icore_cpanel_staging_managed_checkout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ICORE_CPANEL_STAGING.md", "source_location": null, "weight": 1.0}, {"source": "icore_cpanel_staging_deploy_script", "target": "icore_cpanel_staging_env", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ICORE_CPANEL_STAGING.md", "source_location": null, "weight": 1.0}, {"source": "icore_cpanel_staging_deploy_script", "target": "icore_cpanel_staging_demo_seeder", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ICORE_CPANEL_STAGING.md", "source_location": null, "weight": 1.0}, {"source": "icore_cpanel_staging_env", "target": "modules_recommerce_readme_recommerce_writes_enabled", "relation": "references", "c