{"nodes": [{"id": "recommerce_ui_design_document", "label": "Recommerce UI Design", "file_type": "document", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_ui_design_design_principles", "label": "UI Design Principles", "file_type": "rationale", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scan first, searchable second, manual entry last; irreversible posting must look visibly different from editable preparation, and colour alone never carries status."}, {"id": "recommerce_ui_design_navigation", "label": "Recommerce Navigation Structure", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Permission checks apply server-side even when navigation is hidden, so menu visibility is never the access control."}, {"id": "recommerce_ui_design_global_scan_surface", "label": "Global Scan Capture Drawer", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The scan router may open a device, job, receive/transfer confirmation, sale assignment or collection action, but never executes a stock mutation from the scan alone."}, {"id": "recommerce_ui_design_counter_dashboard", "label": "Counter Dashboard", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a74.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_ui_design_technician_workbench", "label": "Technician Workbench", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a74.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Batch status changes are not allowed for repair work because each transition needs its own evidence."}, {"id": "recommerce_ui_design_manager_control_view", "label": "Manager Control View", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a74.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Totals are operational indicators rather than accounting reports, so every card links to the underlying records."}, {"id": "recommerce_ui_design_device_registry_screen", "label": "Device Registry Screen", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identifier values are masked by default and export is a separate audited permission."}, {"id": "recommerce_ui_design_device_detail_screen", "label": "Device Detail Screen", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The header must not imply that product variation equals physical identity, and repair secrets never appear on this general page."}, {"id": "recommerce_ui_design_receiving_screen", "label": "Receiving Screen", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Posting confirmation states the exact POS quantity change and device record count, and large batches paginate virtually while preserving scanner focus."}, {"id": "recommerce_ui_design_customer_repair_intake_stepper", "label": "Customer Repair Intake Stepper", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The review step separates customer statements from staff observations, and passcodes are preferably not stored at all."}, {"id": "recommerce_ui_design_repair_job_detail_screen", "label": "Repair Job Detail Screen", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no free-form status dropdown; transitions are explicit buttons whose dialog lists prerequisites and missing evidence."}, {"id": "recommerce_ui_design_diagnostic_grading_ui", "label": "Diagnostic and Grading UI", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Faults are derived by a human action rather than silently inferred, and templates already used by submitted diagnostics cannot be edited in place."}, {"id": "recommerce_ui_design_parts_and_billing_ui", "label": "Parts and Billing UI", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The UI never offers both the Finalize bill and Consume parts paths for the same usage, preventing double consumption at the interaction level."}, {"id": "recommerce_ui_design_sale_assignment_panel", "label": "POS Sale Device Assignment Panel", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a712", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No silent auto-selection in Alpha; the ordinary POS finalization control remains the final action."}, {"id": "recommerce_ui_design_transfer_ui", "label": "Transfer Send/Receive UI", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a713", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_ui_design_labels_and_printing_ui", "label": "Label Preview and Batch Print UI", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a714", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Token rotation generates a new QR but preserves the permanent human code, so reprints never create a second identity."}, {"id": "recommerce_ui_design_exceptions_and_reconciliation_ui", "label": "Exceptions and Reconciliation UI", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a715", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The comparison view shows POS aggregate, tracked devices and legacy balance side by side; resolution creates ledger entries rather than exposing raw database editing."}, {"id": "recommerce_ui_design_concurrency_feedback", "label": "Feedback, Errors and Concurrency UX", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a716", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A network failure after posting prompts a status check using the idempotency key and must not invite blind resubmission."}, {"id": "recommerce_ui_design_accessibility", "label": "Accessibility and Device Support", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a717", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The UI displays connectivity state and disables prepared stock posting when the server cannot confirm the transaction, because Alpha is online-only."}, {"id": "recommerce_ui_design_alpha_screen_sequence", "label": "Alpha Screen Sequence (First Vertical Slice)", "file_type": "concept", "source_file": "RECOMMERCE_UI_DESIGN.md", "source_location": "\u00a718", 