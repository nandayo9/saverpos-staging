{"nodes": [{"id": "modules_recommerce_readme_module", "label": "Recommerce Module", "file_type": "document", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An Ultimate POS capability, not a second application: it shares native business, locations, roles, contacts, products, stock, sales, payments and accounting, and the operational write boundary stays gated until pilot evidence gates clear."}, {"id": "modules_recommerce_readme_recommerce_enabled", "label": "RECOMMERCE_ENABLED", "file_type": "concept", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "modules_recommerce_readme_recommerce_writes_enabled", "label": "RECOMMERCE_WRITES_ENABLED", "file_type": "concept", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A separate write switch from RECOMMERCE_ENABLED so read-only navigation can be verified before any mutation is possible."}, {"id": "modules_recommerce_readme_cohortpolicy", "label": "Support/CohortPolicy.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "modules_recommerce_readme_authorizationgate", "label": "Support/AuthorizationGate.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires a catalogued permission in addition to the configured scope, so all routes stay unreachable while the module status or feature switch is off."}, {"id": "modules_recommerce_readme_devicecode", "label": "Support/Identity/DeviceCode.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "modules_recommerce_readme_opaquescantoken", "label": "Support/Identity/OpaqueScanToken.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Issues 256-bit tokens and stores an application-keyed lookup hash; V2.2 additionally stores the raw token as an encrypted attribute purely so an authorized reprint reproduces the same QR identity, and it is never logged or returned."}, {"id": "modules_recommerce_readme_scaninput", "label": "Support/Identity/ScanInput.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "modules_recommerce_readme_strongidentifierhasher", "label": "Support/Identity/StrongIdentifierHasher.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normalizes physical identifiers for keyed business-scoped lookup without retaining plaintext; the DB guard is scoped by business and identifier type to prevent duplicates within one namespace."}, {"id": "modules_recommerce_readme_labelpayloadbuilder", "label": "Support/LabelPayloadBuilder.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "modules_recommerce_readme_labelrenderer", "label": "Services/LabelRenderer.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs inside token issuance so a rendering failure rolls back the token and its timeline event for a safe retry; SVG output echoing the opaque URL is rejected at the renderer boundary."}, {"id": "modules_recommerce_readme_trackedreceivingservice", "label": "Services/TrackedReceivingService.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Atomic receiving contract with idempotency, exact core-quantity assertion and same-transaction Device evidence; attachToExistingUltimatePosPurchase() is the production seam that locks the purchase line and avoids writing aggregate stock twice."}, {"id": "modules_recommerce_readme_deviceeventrecorder", "label": "Services/DeviceEventRecorder.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes the minimal immutable receive timeline inside the same transaction with durable UUID/version, plus one pending tenant-scoped outbox message; no external dispatcher is enabled in this inactive scaffold."}, {"id": "modules_recommerce_readme_ultimatepospurchasewriter", "label": "Services/UltimatePosPurchaseWriter.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source-reviewed adapter for native transaction/purchase-line/stock-utility primitives, deliberately not route-exposed so TrackedReceivingService owns the transaction."}, {"id": "modules_recommerce_readme_stockreconciliationservice", "label": "Services/StockReconciliationService.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TRACKED_REQUIRED establishes zero legacy stock while LEGACY_MIXED needs a location-scoped balance row; missing evidence is UNAVAILABLE and caller-supplied balances are rejected. The same calculation blocks a new tracked receive on MISMATCH or EXCEPTION."}, {"id": "modules_recommerce_readme_reconciliationrunservice", "label": "Services/ReconciliationRunService.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separately permissioned evidence-recording path storing an immutable snapshot and SHA-256 result hash; it never edits POS or tracked stock state."}, {"id": "modules_recommerce_readme_scantokenissuanceservice", "label": "Services/ScanTokenIssuanceService.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reprint reuses existing encrypted token material to preserve Device/QR identity; tokens predating the encrypted-material migration stay valid but must go through the separately approved rotation recovery path rather than being silently reprinted."}, {"id": "modules_recommerce_readme_deviceeventtimelineservice", "label": "Services/DeviceEventTimelineService.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shared safe projection used by both the JSON endpoint and Device Detail view, preventing the two surfaces from drifting into different event-exposure rules."}, {"id": "modules_recommerce_readme_labelcontroller", "label": "Http/Controllers/LabelController.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records PRINT_VIEW_OPENED separately from staff-attested PRINT_CONFIRMED/REPRINT_CONFIRMED, because opening a browser print view is not proof a physical printer completed the job."}, {"id": "modules_recommerce_readme_devicecontroller", "label": "Http/Controllers/DeviceController.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "modules_recommerce_readme_deviceeventcontroller", "label": "Http/Controllers/DeviceEventController.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "modules_recommerce_readme_scancontroller", "label": "Http/Controllers/ScanController.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unknown, revoked and non-certified tokens share one neutral no-store/noindex 404 containing no Device data, so future public-passport work can extend the resolver without replacing physical labels."}, {"id": "modules_recommerce_readme_reconciliationcontroller", "label": "ReconciliationController.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "modules_recommerce_readme_receivingcontroller", "label": "ReceivingController.php", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps only ReceivingInProgressException to a retryable 409 and ReceivingReconciliationBlockedException to a stop-line 409, so unexpected purchase-adapter failures are never mislabeled as duplicate work."}, {"id": "modules_recommerce_readme_devicecertificationservice", "label": "DeviceCertificationService", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Publication is permitted only for an already-sold Device under recommerce.device.certify; it creates no sale or second accounting ledger, and per-device price/gross-profit display stays blocked on an evidence-linked POS sell-line assignment rather than being inferred."}, {"id": "modules_recommerce_readme_devicelifecycleservice", "label": "DeviceLifecycleService", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Projects selected tracked devices onto native sell/sell-return/transfer transactions using locked rows and append-only evidence; a final tracked sale without exactly one SaverBro code per unit is rejected and returned devices default to RETURNED_PENDING_INSPECTION rather than available stock."}, {"id": "modules_recommerce_readme_public_certification_projection", "label": "Public SaverBro Certification Projection", "file_type": "concept", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exposes only product name, masked serial suffix, grade, QC pass, battery health, purchase date and warranty expiry; custody, ownership, price/cost, margins, raw identifiers, events and token material are never part of it."}, {"id": "modules_recommerce_readme_label_v22", "label": "V2.2 Physical Label (50 mm x 38 mm)", "file_type": "concept", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 20 mm high-error-correction QR is the primary identity and the human Device code is mandatory; the 10 mm Code128 is only a secondary scanner aid and QR geometry must not be reduced to retain it on a smaller template."}, {"id": "modules_recommerce_readme_activation_sequence", "label": "POS Integration and Activation Sequence", "file_type": "concept", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four staged steps (migrate with feature off, configure cohort, enable read-only navigation, then enable writes only after receiving/label/repair/concurrency/reconciliation evidence) so no step exposes a write path before it is proven."}, {"id": "modules_recommerce_readme_purchase_edit_lock", "label": "Native Purchase Edit/Delete Lock After Device Identification", "file_type": "rationale", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The native edit screen saves administrative metadata and stock-affecting purchase lines in one operation, so a seemingly harmless edit could rewrite Device provenance or aggregate stock; a future metadata-only correction flow must be explicit, permissioned, audited and must not call the purchase-line rewrite path."}, {"id": "modules_recommerce_readme_repair_slice", "label": "Owned Repair Vertical Slice", "file_type": "concept", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Customer-owned Devices use stock_participation=NONE and a rate-limited public status projection that excludes contact data, internal notes, financials, diagnostics and credentials."}, {"id": "modules_recommerce_readme_static_check", "label": "scripts/recommerce-static-check.mjs", "file_type": "code", "source_file": "Modules/Recommerce/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dependency-free verification for the preview and receiving Blade handoff when the PHP runtime is unavailable."}], "edges": [{"source": "modules_recommerce_readme_module", "target": "modules_recommerce_readme_recommerce_enabled", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Modules/Recommerce/README.md", "source_location": null, "weight": 1.0}, {"source": "modules_recommerce_readme_module", "target": "modules_recommerce_readme_recommerce_writes_enabled", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Modules/Recommerce/README.md", "source_location": null, "weight": 1.0}, {"source": "modules_recommerce_readme_cohortpolicy", "target": "modules_recommerce_readme_recommerce_writes_enabled", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Modules/Recommerce/README.md", "source_location": null, "weight": 1.0}, {"source": "modules_recommerce_readme_authorizationgate", "target": "modules_recommerce_readme_cohortpolicy", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Modules/Recommerce/README.md", "source_location": null, "weight": 1.0}, {"source": "modules_recommerce_readme_opaquescantoken", "target": "modules_recommerce_readme_devicecode", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Modules/Recommerce/README.md", "source_location": null, "weight": 1.0}, {"source": "modules_recommerce_readme_scaninput", "target": "modules_recommerce_readme_devicecode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Modules/Recommerce/README.md", "source_location": null, "weight": 1.0}, {"source": "modules_recommerce_readme_labelpayloadbuilder", "target": "modules_recommerce_readme_labelrenderer", "relation": "shares_data_with", "confidence": "EXTRACTED", "