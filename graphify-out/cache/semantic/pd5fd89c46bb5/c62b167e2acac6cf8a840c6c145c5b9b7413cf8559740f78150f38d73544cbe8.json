{"nodes": [{"id": "rcr_002_evidence_intake_template", "label": "RCR-002 Evidence Intake Template", "file_type": "document", "source_file": "RCR_002_EVIDENCE_INTAKE_TEMPLATE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_002_evidence_intake_template_evidence_register", "label": "Evidence Register RCR2-E01..E08", "file_type": "concept", "rationale": "Eight numbered evidence slots (schema/migration history, business/location, product/variation, stock by location, open transactions, Repair extract, hardware inventory, Alpha users/approval) each require file hash, extraction time, owner and approval so that no item can be accepted informally.", "source_file": "RCR_002_EVIDENCE_INTAKE_TEMPLATE.md", "source_location": "Section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_002_evidence_intake_template_snapshot_manifest", "label": "Snapshot Manifest", "file_type": "concept", "source_file": "RCR_002_EVIDENCE_INTAKE_TEMPLATE.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_002_evidence_intake_template_alpha_cohort", "label": "Alpha Cohort Definition", "file_type": "concept", "rationale": "One approved business, location, category and variation scope with a source-of-truth quantity date, so the pilot has a single provable stock baseline instead of an inferred one.", "source_file": "RCR_002_EVIDENCE_INTAKE_TEMPLATE.md", "source_location": "Section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_002_evidence_intake_template_reconciliation_formula", "label": "Stock Reconciliation Formula", "file_type": "rationale", "rationale": "calculated qty = opening qty + purchases - sales + sales returns - purchase returns + adjustments + transfers in - transfers out. It is explicitly a discovery control, not an assertion that every deployment applies the same posting semantics, so each movement type must be confirmed against approved source totals.", "source_file": "RCR_002_EVIDENCE_INTAKE_TEMPLATE.md", "source_location": "Section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_002_evidence_intake_template_identifier_duplicate_sample", "label": "Identifier and Duplicate Sample", "file_type": "concept", "rationale": "The minimum sample must include normal matches, missing identifiers, duplicate identifiers, conflicting identifiers, repaired devices and business-owned sellable stock, so identifier design is tested against real collision shapes rather than a clean case.", "source_file": "RCR_002_EVIDENCE_INTAKE_TEMPLATE.md", "source_location": "Section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_002_evidence_intake_template_acceptance_decision", "label": "RCR-002 Acceptance Decision PENDING EVIDENCE", "file_type": "rationale", "rationale": "RCR-002 may be marked ready only when every acceptance row is Pass or carries an explicitly approved exception; unverified items stay pending rather than defaulting to acceptable.", "source_file": "RCR_002_EVIDENCE_INTAKE_TEMPLATE.md", "source_location": "Section 8", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "rcr_002_evidence_intake_template", "target": "rcr_001_baseline_report", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_002_EVIDENCE_INTAKE_TEMPLATE.md", "source_location": "Section 9", "weight": 1.0}, {"source": "rcr_002_evidence_intake_template", "target": "rcr_002_provisional_profile", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_002_EVIDENCE_INTAKE_TEMPLATE.md", "source_location": "Section 9", "weight": 1.0}, {"source": "rcr_002_evidence_intake_template", "target": "rcr_002_evidence_intake_template_evidence_reg