{"nodes": [{"id": "rcr_002_reconciliation_spec", "label": "RCR-002 Read-Only Reconciliation Specification", "file_type": "document", "source_file": "RCR_002_RECONCILIATION_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_002_reconciliation_spec_safety_boundary", "label": "Read-Only Query Safety Boundary", "file_type": "rationale", "rationale": "This is a query specification, not a production-access instruction: execute only against an approved read-only or disposable sanitized database, bind all scope parameters, and run no writes, migrations, seeders, imports or application actions. Each query must first confirm its referenced table and column exist.", "source_file": "RCR_002_RECONCILIATION_SPEC.md", "source_location": "Safety boundary", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_002_reconciliation_spec_q00_schema_preflight", "label": "Q00 Schema and Snapshot Preflight", "file_type": "concept", "rationale": "Stops on a missing core table, unknown migration revision, or a write-capable connection, so no later query runs against an unqualified or mutable snapshot.", "source_file": "RCR_002_RECONCILIATION_SPEC.md", "source_location": "Q00", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_002_reconciliation_spec_q02_identity_extract", "label": "Q02 Product and Variation Identity Extract", "file_type": "concept", "rationale": "Does not assume sku, sub_sku or any barcode column is globally unique until duplicate checks prove the actual business/location rule.", "source_file": "RCR_002_RECONCILIATION_SPEC.md", "source_location": "Q02", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_002_reconciliation_spec_q03_current_source_stock", "label": "Q03 Current Source Stock", "file_type": "concept", "rationale": "Reads variation_location_details for the approved scope, keeping zero-quantity rows, reporting missing rows separately and preserving decimal precision so a variance cannot be hidden by dropped rows.", "source_file": "RCR_002_RECONCILIATION_SPEC.md", "source_location": "Q03", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_002_reconciliation_spec_control_equation", "label": "Q04 Movement Control Equation", "file_type": "rationale", "rationale": "calculated_qty = opening_qty + purchases - sales + sales_returns - purchase_returns + adjustments + transfers_in - transfers_out, used only after status semantics are confirmed. Variance is reported, never silently corrected, and neither value is overwritten.", "source_file": "RCR_002_RECONCILIATION_SPEC.md", "source_location": "Q04", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_002_reconciliation_spec_q06_duplicate_scan", "label": "Q06 Identifier Duplicate/Conflict Scan", "file_type": "concept", "rationale": "Normalizes identifiers with a documented non-destructive rule, reports six duplicate/conflict classes, and keeps raw values in a restricted evidence store with surrogate sample IDs in the report.", "source_file": "RCR_002_RECONCILIATION_SPEC.md", "source_location": "Q06", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_002_reconciliation_spec_q07_repair_dependency_probe", "label": "Q07 Repair Dependency Probe", "file_type": "concept", "rationale": "Legacy provider Repair schema must be discovered before any legacy Repair query is valid; no legacy schema is inferred from status or cache files. SaverBro-owned Repair tables are inventoried separately.", "source_file": "RCR_002_RECONCILIATION_SPEC.md", "source_location": "Q07", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_002_reconciliation_spec_acceptance_thresholds", "label": "Reconciliation Acceptance Thresholds", "file_type": "rationale", "rationale": 