{"nodes": [{"id": "rcr_006_local_control_record", "label": "RCR-006 Recommerce Increment Control Record", "file_type": "document", "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_006_local_control_record_recommerce_module", "label": "Modules/Recommerce Inactive Module", "file_type": "concept", "rationale": "The whole increment ships as source behind a disabled boundary: modules_statuses.json records Recommerce false, no migration has been executed, and the route provider registers no Recommerce routes while disabled.", "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Scope delivered / Safety controls", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_006_local_control_record_default_off_switches", "label": "Default-Off Module and Write Switches", "file_type": "rationale", "rationale": "RECOMMERCE_ENABLED and RECOMMERCE_WRITES_ENABLED both default to false so that every write route denies by default through the write switch, permission, cohort policy and core location permission intersection.", "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Safety controls", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_006_local_control_record_cohort_policy", "label": "CohortPolicy Business/Location/Variation Scope", "file_type": "concept", "rationale": "An explicit business, location and variation cohort intersected with permissions bounds every Recommerce read and write, so tracked behavior cannot leak into non-pilot stock.", "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Scope delivered", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_006_local_control_record_device_code", "label": "Stable Human Device Code", "file_type": "concept", "rationale": "A permanent human-readable Device code with a check character is the operator-facing identity, kept separate from the opaque scan token so a printed label carries no secret material.", "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Scope delivered", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_006_local_control_record_opaque_scan_token", "label": "Opaque Scan Token", "file_type": "concept", "rationale": "A 256-bit opaque token with keyed hashing and constant-time comparison; raw token material is never stored or logged, is excluded from event metadata, API responses and human-readable label markup, and the public QR resolver redirects to a neutral login before any token lookup so known, revoked and unknown tokens are indistinguishable.", "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Scope delivered / Verification", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_006_local_control_record_tracked_receiving_service", "label": "TrackedReceivingService", "file_type": "concept", "rationale": "Atomic tracked-receiving service requiring exact core scope and idempotency, serializing receives per business behind a business-row lock before idempotency and identifier checks, creating one Device evidence set per received unit plus a dated BUSINESS ownership period and LOCATION custody period in the same transaction.", "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Scope delivered", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_006_local_control_record_ultimatepos_purchase_writer", "label": "UltimatePosPurchaseWriter Adapter", "file_type": "concept", "rationale": "Reuses core transaction, purchase-line, stock, payment-status, activity and event primitives without opening a nested transaction, and rejects missing business-session date context before creating a core transaction. It is reachable only through the guarded post endpoint.", "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Scope delivered / Verification", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_006_local_control_record_stock_reconciliation_service", "label": "StockReconciliationService", "file_type": "concept", "rationale": "Compares core quantity, tracked Devices and approved persisted legacy balance with no automatic correction, reporting PASS, MISMATCH, EXCEPTION or UNAVAILABLE. It excludes in-transfer Devices, never treats a missing core row as zero, and rejects caller-supplied legacy balances so a request cannot manufacture a passing quantity.", "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Scope delivered / Verification", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_006_local_control_record_reconciliation_stop_line", "label": "Reconciliation Mismatch Stop-Line Guard", "file_type": "rationale", "rationale": "New tracked receiving is blocked when the current scoped reconciliation is MISMATCH or EXCEPTION. The guard runs after idempotency replay/conflict checks so a completed command can still replay its original result, and it raises a dedicated exception mapped to a generic no-store 409 without calling the core writer.", "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Verification", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_006_local_control_record_device_event_timeline", "label": "Immutable Device Event Timeline", "file_type": "concept", "rationale": "Append-only RECEIVE_POSTED, LABEL_TOKEN_ISSUED and LABEL_TOKEN_ROTATED events carry actor and source provenance with allowlisted safe metadata, a durable UUID and version, and a tenant-scoped outbox row written in the same transaction so evidence and event roll back together.", "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Scope delivered / Verification", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_006_local_control_record_label_renderer", "label": "Bounded Label Renderer", "file_type": "concept", "rationale": "Renders installed Code128 and QR SVG components into a standalone print-ready view inside the scan-token issuance transaction, so a renderer failure rolls back the token and label event and permits retry without rotation. It rejects SVG output that echoes the opaque QR URL, keeping the no-human-readable-token invariant at the renderer boundary.", "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Verification", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_006_local_control_record_identifier_hash_storage", "label": "Type-Scoped Hash-Only Identifier Storage", "file_type": "concept", "rationale": "Identifier lookup uses a required business-and-type-scoped normalized hash so SQL uniqueness cannot be bypassed with NULL, no plaintext normalized-value column remains, and raw identifier values are encrypted at rest and hidden from serialization; UI hints mask all but the final two characters.", "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Verification", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rcr_006_local_control_record_release_decision", "label": "NOT RELEASE READY Decision", "file_type": "rationale", "rationale": "Before enabling the increment, recover RCR-001 runtime/module evidence, complete RCR-002 Alpha data and hardware profiling, prove the RCR-003 transaction contract, run the migration on a disposable production-like database, and execute the listed browser, security and runtime tests.", "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Release decision", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "rcr_006_local_control_record", "target": "rcr_002_provisional_profile", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Planning/control documents", "weight": 1.0}, {"source": "rcr_006_local_control_record", "target": "rcr_002_evidence_intake_template", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Planning/control documents", "weight": 1.0}, {"source": "rcr_006_local_control_record", "target": "rcr_002_reconciliation_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Planning/control documents", "weight": 1.0}, {"source": "rcr_006_local_control_record", "target": "rcr_002_hardware_test_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Planning/control documents", "weight": 1.0}, {"source": "rcr_006_local_control_record", "target": "rcr_003_receiving_contract_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Planning/control documents", "weight": 1.0}, {"source": "rcr_006_local_control_record", "target": "rcr_006_local_control_record_recommerce_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Scope delivered", "weight": 1.0}, {"source": "rcr_006_local_control_record", "target": "rcr_006_local_control_record_release_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RCR_006_LOCAL_CONTROL_RECORD.md", "source_location": "Release decision", "weight": 1.0}, {"source": "rcr_006_local_control_record_recommerce_modu