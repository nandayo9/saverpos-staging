{"nodes": [{"id": "recommerce_security_and_permissions_document", "label": "Security and Permissions", "file_type": "document", "source_file": "RECOMMERCE_SECURITY_AND_PERMISSIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recommerce_security_and_permissions_security_objectives", "label": "Six Security Objectives", "file_type": "concept", "source_file": "RECOMMERCE_SECURITY_AND_PERMISSIONS.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spatie permissions and existing business/location patterns are a starting point, not complete protection; every query and command needs server-side scope enforcement."}, {"id": "recommerce_security_and_permissions_role_templates", "label": "Role Templates", "file_type": "concept", "source_file": "RECOMMERCE_SECURITY_AND_PERMISSIONS.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Roles are deployable templates rather than hard-coded names so businesses can compose permissions while protected combinations and segregation rules stay enforced."}, {"id": "recommerce_security_and_permissions_permission_catalog", "label": "Recommerce Permission Catalog", "file_type": "concept", "source_file": "RECOMMERCE_SECURITY_AND_PERMISSIONS.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate view, prepare, post, approve, override, reveal and export abilities exist so a broad module permission never implies all of them."}, {"id": "recommerce_security_and_permissions_authorization_intersection", "label": "Authorization Intersection Rule", "file_type": "rationale", "source_file": "RECOMMERCE_SECURITY_AND_PERMISSIONS.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Access equals permission \u2229 business \u2229 allowed locations \u2229 object assignment/policy \u2229 current state; task assignment alone must not grant financial or customer contact access."}, {"id": "recommerce_security_and_permissions_segregation_of_duties", "label": "Segregation of Duties Controls", "file_type": "concept", "source_file": "RECOMMERCE_SECURITY_AND_PERMISSIONS.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A technician cannot approve their own QC and a security administrator cannot silently read repair secrets; the system records both actors where dual control applies."}, {"id": "recommerce_security_and_permissions_sensitive_data_classification", "label": "Sensitive Data Classification", "file_type": "concept", "source_file": "RECOMMERCE_SECURITY_AND_PERMISSIONS.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classes run from public-safe resolver URLs to security secrets whose raw values are never stored; sensitive values must not appear in labels, post-resolution route parameters, analytics, exception messages, activity descriptions, notifications or default export columns."}, {"id": "recommerce_security_and_permissions_authentication_and_sessions", "label": "Authentication and Session Policy", "file_type": "concept", "source_file": "RECOMMERCE_SECURITY_AND_PERMISSIONS.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A QR token is never treated as authentication, and future scanner/mobile APIs must use scoped first-party credentials rather than broad personal access tokens."}, {"id": "recommerce_security_and_permissions_input_file_output_controls", "label": "Input, File and Output Controls", "file_type": "concept", "source_file": "RECOMMERCE_SECURITY_AND_PERMISSIONS.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Private repair files are never served from predictable public paths, and spreadsheet exports neutralize formula injection."}, {"id": "recommerce_security_and_permissions_audit_and_event_integrity", "label": "Audit and Event Integrity", "file_type": "concept", "source_file": "RECOMMERCE_SECURITY_AND_PERMISSIONS.md", "source_location": "\u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spatie activity logging can mirror summaries but its retention and general-purpose nature mean it is not the sole device timeline; passcodes, access tokens, raw QR tokens and payment credentials are never logged."}, {"id": "recommerce_security_and_permissions_qr_and_scan_security", "label": "QR and Scan Security Requirements", "file_type": "concept", "source_file": "RECOMMERCE_SECURITY_AND_PERMISSIONS.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "128+ bits of entropy, hash-at-rest with exact match only, revocation/rotation with event history, separate public and authenticated rate limits, and a generic unauthorized/not-found response."}, {"id": "recommerce_security_and_permissions_concurrency_controls", "label": "Security-Side Concurrency and Integrity Controls", "file_type": "concept", "source_file": "RECOMMERCE_SECURITY_AND_PERMISSIONS.md", "source_location": "\u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authorization must be re-checked after acquiring locks, because state or scope can have changed between the first check and the lock."}, {"id": "recommerce_security_and_permissions_threat_model", "label": "Threat Scenarios and Primary Controls", "file_type": "concept", "source_file": "RECOMMERCE_SECURITY_AND_PERMISSIONS.md", "source_location": "\u00a712", "source_url": null, "captured_at": null, "author": null, "contrib