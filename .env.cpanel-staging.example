APP_NAME=SAVERPOS
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos.kkcctv.com.my
APP_TIMEZONE=Asia/Kuching

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANEL_DATABASE_NAME
DB_USERNAME=CPANEL_DATABASE_USER
DB_PASSWORD=ENTER_IN_CPANEL_ONLY

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=daily
ALLOW_REGISTRATION=false

RECOMMERCE_ENABLED=true
RECOMMERCE_WRITES_ENABLED=true
# Optional when APP_URL is the approved public QR origin; set a different
# HTTPS host[:port] only when labels must resolve through that dedicated host.
RECOMMERCE_RESOLVER_HOST=pos.kkcctv.com.my
RECOMMERCE_COHORT_BUSINESS_ID=1
RECOMMERCE_COHORT_LOCATION_ID=1
RECOMMERCE_COHORT_LOCATION_IDS=1,2
RECOMMERCE_COHORT_VARIATION_IDS=1
# Disabled until the website staging host, a dedicated service actor and a
# separate high-entropy secret have been approved. Never reuse the read token.
RECOMMERCE_TRADEIN_COMMAND_ENABLED=false
RECOMMERCE_TRADEIN_COMMAND_BEARER_TOKEN=
RECOMMERCE_TRADEIN_COMMAND_CONTRACT_VERSION=1.0
RECOMMERCE_TRADEIN_COMMAND_ACTOR_USER_ID=
RECOMMERCE_TRADEIN_COMMAND_BUSINESS_ID=1
RECOMMERCE_TRADEIN_COMMAND_LOCATION_IDS=1,2
RECOMMERCE_TRADEIN_COMMAND_VARIATION_IDS=1
RECOMMERCE_TRADEIN_OUTBOX_ENABLED=false
RECOMMERCE_PHOTO_AI_STAFF_ENABLED=false
RECOMMERCE_TRADEIN_OUTBOX_WEBSITE_URL=
RECOMMERCE_TRADEIN_OUTBOX_HMAC_SECRET=
RECOMMERCE_TRADEIN_OUTBOX_WEBSITE_BASIC_AUTH=
RECOMMERCE_TRADEIN_OUTBOX_ALLOWED_HOSTS=
RECOMMERCE_TRADEIN_OUTBOX_ALLOW_INSECURE_LOCAL=false
# Allows authorised cohort users to choose Individual Device or Quantity when
# creating a product. Set false only to deliberately pause new policies.
RECOMMERCE_ALLOW_APPROVED_PRODUCT_POLICIES=true
